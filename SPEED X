local function NetGet(...)
    if not aC or not aC.func then return end
    local aD={...}
    for aE,aF in ipairs(aD)do
        if typeof(aF)=="Instance"then
            if aF:IsA"Model"and#aF:GetChildren()==0 then
                local aG=g:FindFirstChild"DroppedItems"
                if aG then
                    local aH=aG:FindFirstChildWhichIsA"Model"
                    if aH then aD[aE]=aH else return end
                else return end
            end
        end
    end
    aC.func=(aC.func or 0)+1
    local aE,aF=pcall(function()
        local aE2=c:WaitForChild"Remotes":WaitForChild"Get"
        return aE2:InvokeServer(aC.func,unpack(aD))
    end)
    if not aE then warn("[NetGet Error]",aF) end
    return aF
end

