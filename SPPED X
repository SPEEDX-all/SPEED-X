-- 4. ระบบการทำงานหลัก (Core Logic)
-- =========================================
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- ค้นหาฆาตกร
local function GetMurderer()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local backpack = p:FindFirstChild("Backpack")
            local char = p.Character
            local hasKnife = (backpack and backpack:FindFirstChild("Knife")) or (char and char:FindFirstChild("Knife"))
            if hasKnife and char:FindFirstChild("Head") and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
                return char
            end
        end
    end
    return nil
end

-- เช็คปืนในมือ
local function IsHoldingGun()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("Gun") then
        return true
    end
    return false
end

-- ค้นหาเป้าหมายผู้เล่นคนอื่นที่ยังไม่ตายสำหรับ Backstab TP
local function GetNextTarget()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 and p.Character:FindFirstChild("HumanoidRootPart") then
            return p.Character
        end
    end
    return nil
end

-- ลูปการทำงานระบบ Speed, SpinBot, Aimbot, Auto Grab Gun, Backstab TP
task.spawn(function()
    while task.wait(0.01) do
        pcall(function()
            local char = LocalPlayer.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then return end
            local hrp = char.HumanoidRootPart

            -- ระบบ WalkSpeed
            if char:FindFirstChild("Humanoid") and _G.SpeedToggle then
                char.Humanoid.WalkSpeed = _G.WalkSpeedValue
            end

            -- ระบบ SpinBot
            if _G.SpinToggle then
                hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(_G.SpinSpeedValue), 0)
            end

            -- ระบบ Lock Head (Aimbot)
            if _G.SheriffAimbot and IsHoldingGun() then
                local murdererChar = GetMurderer()
                if murdererChar and murdererChar:FindFirstChild("Head") then
                    Camera.CFrame = CFrame.new(Camera.CFrame.Position, murdererChar.Head.Position)
                end
            end

            -- ระบบ Auto Grab Dropped Gun
            if _G.AutoGrabGun then
                local gunDrop = workspace:FindFirstChild("GunDrop", true)
                if gunDrop and gunDrop:IsA("BasePart") then
                    hrp.CFrame = gunDrop.CFrame * CFrame.new(0, 1, 0)
                end
            end

            -- ระบบ Backstab Target TP (วาร์ปไปหลังผู้เล่นรัวๆ)
            if _G.BackstabTP then
                local targetChar = GetNextTarget()
                if targetChar and targetChar:FindFirstChild("HumanoidRootPart") then
                    -- วาร์ปไปซ้อนด้านหลังเป้าหมาย 2.5 บล็อก
                    hrp.CFrame = targetChar.HumanoidRootPart.CFrame * CFrame.new(0, 0, 2.5)
                end
            end
        end)
    end
end)

-- ระบบ ESP
local function GetRoleColor(player)
    local backpack = player:FindFirstChild("Backpack")
    local char = player.Character

    local hasKnife = (backpack and backpack:FindFirstChild("Knife")) or (char and char:FindFirstChild("Knife"))
    local hasGun = (backpack and backpack:FindFirstChild("Gun")) or (char and char:FindFirstChild("Gun"))

    if hasKnife then
        return Color3.fromRGB(255, 0, 0) -- ฆาตกร = สีแดง
    elseif hasGun then
        return Color3.fromRGB(0, 100, 255) -- ตำรวจ = สีน้ำเงิน
    else
        return Color3.fromRGB(0, 255, 100) -- ผู้บริสุทธิ์ = สีเขียว
    end
end

task.spawn(function()
    while task.wait(0.5) do
        if _G.ESP then
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    local color = GetRoleColor(p)
                    local highlight = p.Character:FindFirstChild("RoleHighlight")
                    
                    if not highlight then
                        highlight = Instance.new("Highlight")
                        highlight.Name = "RoleHighlight"
                        highlight.Parent = p.Character
                    end
                    
                    highlight.FillColor = color
                    highlight.FillTransparency = 0.5
                    highlight.OutlineColor = color
                    highlight.OutlineTransparency = 0
                end
            end
        else
            for _, p in pairs(Players:GetPlayers()) do
                if p.Character then
                    local highlight = p.Character:FindFirstChild("RoleHighlight")
                    if highlight then highlight:Destroy() end
                end
            end
        end
    end
end)
