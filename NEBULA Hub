local activeLines = {}

local function clearSnaplines()
	for _, line in pairs(activeLines) do
		line:Destroy()
	end
	activeLines = {}
end

local function getGunOriginPosition()
	local myChar = LocalPlayer.Character
	if not myChar then return nil end
	
	for _, tool in ipairs(myChar:GetChildren()) do
		if tool:IsA("Tool") then
			local handle = tool:FindFirstChild("Handle") or tool:FindFirstChildOfClass("BasePart")
			if handle then
				return handle.Position
			end
		end
	end
	
	local rightArm = myChar:FindFirstChild("RightHand") or myChar:FindFirstChild("Right Arm")
	if rightArm then return rightArm.Position end
	
	local rootPart = myChar:FindFirstChild("HumanoidRootPart")
	if rootPart then return rootPart.Position end
	
	return nil
end

RunService.RenderStepped:Connect(function()
	clearSnaplines()
	if not gunSnaplineEnabled then return end

	local myChar = LocalPlayer.Character
	if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end
	local myRoot = myChar.HumanoidRootPart
	
	local gunWorldPos = getGunOriginPosition()
	if not gunWorldPos then return end

	local gunScreenPos, gunOnScreen = Camera:WorldToViewportPoint(gunWorldPos)
	if not gunOnScreen then return end
	local gunPos2D = Vector2.new(gunScreenPos.X, gunScreenPos.Y)

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			local targetChar = player.Character
			local humanoid = targetChar:FindFirstChildOfClass("Humanoid")
			local rootPart = targetChar:FindFirstChild("HumanoidRootPart")

			if humanoid and humanoid.Health > 0 and rootPart then
				local distance = (myRoot.Position - rootPart.Position).Magnitude
				if distance <= 40 then
					local targetScreenPos, targetOnScreen = Camera:WorldToViewportPoint(rootPart.Position)
					if targetOnScreen then
						local targetPos2D = Vector2.new(targetScreenPos.X, targetScreenPos.Y)
						local lineDist = (targetPos2D - gunPos2D).Magnitude
						local lineAngle = math.atan2(targetPos2D.Y - gunPos2D.Y, targetPos2D.X - gunPos2D.X)

						local line = Instance.new("Frame")
						line.Size = UDim2.new(0, lineDist, 0, 2)
						line.Position = UDim2.new(0, gunPos2D.X, 0, gunPos2D.Y)
						line.AnchorPoint = Vector2.new(0, 0.5)
						line.BackgroundColor3 = Color3.fromRGB(168, 85, 247)
						line.BackgroundTransparency = 0.2
						line.BorderSizePixel = 0
						line.Rotation = math.deg(lineAngle)
						line.Parent = SnaplineContainer

						local stroke = Instance.new("UIStroke")
						stroke.Color = Color3.fromRGB(98, 45, 155)
						stroke.Transparency = 0.2
						stroke.Thickness = 1
						stroke.Parent = line

						table.insert(activeLines, line)
					end
				end
			end
		end
	end
end)

-- UI TWEEN ANIMATIONS
local tweenInfo = TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
local isAnimating = false

local function ToggleUI(open)
	if isAnimating then return end
	isAnimating = true

	if open then
		FloatBtn.Active = false
		local floatTween = TweenService:Create(FloatBtn, tweenInfo, {Size = UDim2.new(0, 0, 0, 0)})
		floatTween:Play()
		floatTween.Completed:Connect(function()
			FloatBtn.Visible = false
			MainFrame.Visible = true
			local mainTween = TweenService:Create(MainFrame, tweenInfo, {Size = TargetMainSize, BackgroundTransparency = 0})
			mainTween:Play()
			mainTween.Completed:Connect(function() isAnimating = false end)
		end)
	else
		local mainTween = TweenService:Create(MainFrame, tweenInfo, {Size = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 1})
		mainTween:Play()
		mainTween.Completed:Connect(function()
			MainFrame.Visible = false
			FloatBtn.Visible = true
			FloatBtn.Active = true
			local floatTween = TweenService:Create(FloatBtn, tweenInfo, {Size = UDim2.new(0, 105, 0, 38)})
			floatTween:Play()
			floatTween.Completed:Connect(function() isAnimating = false end)
		end)
	end
end

