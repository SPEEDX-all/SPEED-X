-- TAB CREATION HELPER
local ContentContainers = {}
local TabButtons = {}

local function CreateTab(name, order, btnWidth)
	local TabBtn = Instance.new("TextButton")
	TabBtn.Size = UDim2.new(0, btnWidth or 136, 1, 0)
	TabBtn.BackgroundColor3 = order == 1 and COLOR_ACCENT_DARK or COLOR_CARD_BG
	TabBtn.Text = name
	TabBtn.TextColor3 = order == 1 and COLOR_TEXT_MAIN or COLOR_TEXT_SUB
	TabBtn.Font = Enum.Font.GothamBold
	TabBtn.TextSize = 11
	TabBtn.LayoutOrder = order
	TabBtn.Parent = TabBar
	Instance.new("UICorner", TabBtn).CornerRadius = UDim.new(0, 6)

	local ContentContainer = Instance.new("ScrollingFrame")
	ContentContainer.Size = UDim2.new(1, -230, 1, -60)
	ContentContainer.Position = UDim2.new(0, 215, 0, 50)
	ContentContainer.BackgroundTransparency = 1
	ContentContainer.ScrollBarThickness = 4
	ContentContainer.CanvasSize = UDim2.new(0, 0, 0, 1000)
	ContentContainer.Visible = (order == 1)
	ContentContainer.Parent = MainFrame

	local UIListLayout = Instance.new("UIListLayout")
	UIListLayout.SortOrder = Enum.SortOrder.LayoutOrder
	UIListLayout.Padding = UDim.new(0, 10)
	UIListLayout.Parent = ContentContainer

	ContentContainers[order] = ContentContainer
	TabButtons[order] = TabBtn

	TabBtn.MouseButton1Click:Connect(function()
		for i, container in pairs(ContentContainers) do
			container.Visible = (i == order)
		end
		for i, btn in pairs(TabButtons) do
			if i == order then
				btn.BackgroundColor3 = COLOR_ACCENT_DARK
				btn.TextColor3 = COLOR_TEXT_MAIN
			else
				btn.BackgroundColor3 = COLOR_CARD_BG
				btn.TextColor3 = COLOR_TEXT_SUB
			end
		end
	end)

	return ContentContainer
end

