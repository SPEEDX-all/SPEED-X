local HexagonLines = {}
for i = 1, 6 do
	local line = Instance.new("Frame")
	line.Name = "LoopLine" .. i
	line.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	line.BackgroundTransparency = 0.5
	line.BorderSizePixel = 0
	line.Parent = HexagonLinesContainer
	
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(255, 255, 255)
	stroke.Transparency = 0.35
	stroke.Thickness = 2.5
	stroke.LineJoinMode = Enum.LineJoinMode.Round
	stroke.Parent = line
	
	table.insert(HexagonLines, line)
end

local function updateHexagonGeometry(size)
	local radius = size / 2
	local angleStep = math.pi / 3 
	local points = {}
	
	for i = 0, 5 do
		local angle = i * angleStep - (math.pi / 6)
		local x = math.cos(angle) * radius
		local y = math.sin(angle) * radius
		table.insert(points, Vector2.new(x, y))
	end
	
	for i = 1, 6 do
		local p1 = points[i]
		local p2 = points[i < 6 and i + 1 or 1]
		local line = HexagonLines[i]
		
		local center = (p1 + p2) / 2
		local distance = (p2 - p1).Magnitude
		local angle = math.atan2(p2.Y - p1.Y, p2.X - p1.X)
		
		line.Size = UDim2.new(0, distance, 0, 2.5)
		line.Position = UDim2.new(0.5, center.X, 0.5, center.Y)
		line.AnchorPoint = Vector2.new(0.5, 0.5)
		line.Rotation = math.deg(angle)
	end
end

updateHexagonGeometry(260)

-- ค่าความเร็วในการหมุนตัว (ปรับได้จากสไลเดอร์ในแท็บมอง)
local fovRotationSpeed = 25 

local currentRotation = 0
local colorTimer = 0
RunService.RenderStepped:Connect(function(dt)
	if FovContainer.Visible then
		currentRotation = currentRotation + (fovRotationSpeed * dt)
		FovContainer.Rotation = currentRotation
		
		colorTimer = colorTimer + (dt * 0.5)
		local hue = colorTimer % 1
		local rainbowColor = Color3.fromHSV(hue, 0.65, 1)
		
		CircleStroke.Color = rainbowColor
		
		for i, line in ipairs(HexagonLines) do
			local lineHue = (colorTimer + (i * 0.15)) % 1
			local lineRainbowColor = Color3.fromHSV(lineHue, 0.65, 1)
			line.BackgroundColor3 = lineRainbowColor
			local stroke = line:FindFirstChildOfClass("UIStroke")
			if stroke then stroke.Color = lineRainbowColor end
		end
	end
end)

