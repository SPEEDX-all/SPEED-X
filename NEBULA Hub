local function getPredictedTargetPosition(targetPart)
	if not targetPart then return nil end
	local basePos = targetPart.Position
	local velocity = targetPart.AssemblyLinearVelocity or Vector3.new(0, 0, 0)
	local predictionMultiplier = 0.11 
	return basePos + (velocity * predictionMultiplier)
end

local function getClosestTargetPart()
	local myChar = LocalPlayer.Character
	if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil end

	local myRoot = myChar.HumanoidRootPart
	local closestPredictedPos = nil
	local shortestDistance = currentRange
	local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			local targetChar = player.Character
			local targetPartName = isBodyLock and "HumanoidRootPart" or "Head"
			local targetPart = targetChar:FindFirstChild(targetPartName)
			local humanoid = targetChar:FindFirstChildOfClass("Humanoid")

			if targetPart and humanoid and humanoid.Health > 0 then
				local distance = (myRoot.Position - targetPart.Position).Magnitude
				if distance <= shortestDistance then
					local partScreenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
					if onScreen then
						local screenDist = (Vector2.new(partScreenPos.X, partScreenPos.Y) - screenCenter).Magnitude
						if screenDist <= (fovRadius / 2) then
							local raycastParams = RaycastParams.new()
							raycastParams.FilterDescendantsInstances = {myChar, targetChar}
							raycastParams.FilterType = Enum.RaycastFilterType.Exclude
							raycastParams.IgnoreWater = true

							local origin = Camera.CFrame.Position
							local direction = targetPart.Position - origin
							local rayResult = workspace:Raycast(origin, direction, raycastParams)

							if not rayResult then
								shortestDistance = distance
								closestPredictedPos = getPredictedTargetPosition(targetPart)
							end
						end
					end
				end
			end
		end
	end
	return closestPredictedPos
end

RunService.RenderStepped:Connect(function(dt)
	if not aimbotEnabled then return end
	local targetPos = getClosestTargetPart()
	if targetPos then
		local targetCFrame = CFrame.new(Camera.CFrame.Position, targetPos)
		Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, math.clamp(dt * 30, 0.1, 1))
	end
end)

