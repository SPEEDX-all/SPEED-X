local function createESPName(plr)
    if espCache[plr] and espCache[plr].name then return end
    local t = Drawing.new("Text")
    t.Center = true t.Outlined = true
    t.OutlineColor = Color3.fromRGB(0, 0, 0)
    t.Size = 18 t.Font = 2 t.Visible = false
    
    local conn = RunService.RenderStepped:Connect(function()
        pcall(function()
            if not ESPName or not plr.Character then t.Visible = false return end
            local head = plr.Character:FindFirstChild("Head")
            if not head then t.Visible = false return end
            local sp, onScreen = workspace.CurrentCamera:WorldToViewportPoint(head.Position + Vector3.new(0, 3, 0))
            if onScreen and sp.Z > 0 then
                t.Text = plr.Name
                t.Color = isExcluded(plr.Name) and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 255, 255)
                t.Position = Vector2.new(sp.X, sp.Y - 20)
                t.Visible = true
            else
                t.Visible = false
            end
        end)
    end)
    if not espCache[plr] then espCache[plr] = {} end
    espCache[plr].name = t
    espCache[plr].nameConn = conn
end

