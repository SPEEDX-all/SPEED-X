local function findFireRateAttr(tool)
    if not tool then return nil end
    if tool:GetAttribute("fire_rate") ~= nil then return "fire_rate" end
    for name in pairs(tool:GetAttributes()) do
        if type(name) == "string" and name:sub(-3) == "486" then return name end
    end
    return nil
end

local function isGun(tool)
    if not tool or not tool:IsA("Tool") then return false end
    return tool:GetAttribute("reload_time") or tool:GetAttribute("AmmoType") or findFireRateAttr(tool)
end

