local function isExcluded(name)
    for _, f in ipairs(SafeFriendList) do
        if f ~= "" and string.find(string.lower(name), string.lower(f)) then
            return true
        end
    end
    return false
end

local function getPing()
    local pg = LP:FindFirstChild("PlayerGui")
    if not pg then return 0.1 end
    local ns = pg:FindFirstChild("NetworkStats")
    if not ns then return 0.1 end
    local pl = ns:FindFirstChild("PingLabel")
    if not pl then return 0.1 end
    local n = tonumber(pl.Text:match("%d+"))
    if not n then return 0.1 end
    return math.clamp(n / 1000, 0.05, 0.5)
end

local function getHRP()
    if not LP.Character then return nil end
    return LP.Character:FindFirstChild("HumanoidRootPart")
end

local function getHum()
    if not LP.Character then return nil end
    return LP.Character:FindFirstChildOfClass("Humanoid")
end

local function isDowned()
    local h = getHum()
    if not h or h.Health <= 0 then return false end
    return h:GetAttribute("HasBeenDowned") or h:GetAttribute("IsDead")
end

