local function ApplyBackground()
    pcall(function()
        local parent = gethui and gethui() or game:GetService("CoreGui")
        local windGui
        
        for _, gui in ipairs(parent:GetChildren()) do
            if gui:IsA("ScreenGui") and (gui.Name:find("Wind") or gui.Name:find("JUIX")) then
                windGui = gui
                break
            end
        end
        
        if not windGui then
            local pg = LP:FindFirstChild("PlayerGui")
            if pg then
                for _, gui in ipairs(pg:GetChildren()) do
                    if gui:IsA("ScreenGui") and (gui.Name:find("Wind") or gui.Name:find("JUIX")) then
                        windGui = gui
                        break
                    end
                end
            end
        end
        
        if not windGui then return false end
        
        local mainFrame
        for _, d in ipairs(windGui:GetDescendants()) do
            if d:IsA("Frame") and d.AbsoluteSize.X > 400 and d.AbsoluteSize.Y > 250 then
                mainFrame = d
                break
            end
        end
        
        if not mainFrame then return false end
        
        local old = mainFrame:FindFirstChild("JuixBG")
        if old then old:Destroy() end
        
        mainFrame.BackgroundTransparency = 0.5
        
        local bg = Instance.new("ImageLabel")
        bg.Name = "JuixBG"
        bg.Size = UDim2.new(1, 0, 1, 0)
        bg.BackgroundTransparency = 1
        bg.Image = BACKGROUND_ID
        bg.ScaleType = Enum.ScaleType.Crop
        bg.ImageTransparency = 0.1
        bg.ZIndex = 0
        bg.Parent = mainFrame
        Instance.new("UICorner", bg).CornerRadius = UDim.new(0, 16)
        
        print("[BG] Applied!")
        return true
    end)
    return false
end

task.spawn(function()
    task.wait(2)
    for i = 1, 20 do
        if ApplyBackground() then break end
        task.wait(0.5)
    end
end)

UIS.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.G then
