local function createESPHealth(plr)
    if espCache[plr] and espCache[plr].hpBg then return end
    local bg = Drawing.new("Square")
    bg.Filled = false bg.Thickness = 1
    bg.Color = Color3.fromRGB(0, 0, 0)
    bg.Transparency = 0.9 bg.Visible = false
    local fill = Drawing.new("Square")
    fill.Filled = true fill.Transparency = 0.9 fill.Visible = false
    
    local conn = RunService.RenderStepped:Connect(function()
        pcall(function()
            if not ESPHealth or not plr.Character then bg.Visible = false fill.Visible = false return end
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            local hum = plr.Character:FindFirstChild("Humanoid")
            if not hrp or not hum or hum.Health <= 0 then bg.Visible = false fill.Visible = false return end
            local sp, onScreen = workspace.CurrentCamera:WorldToViewportPoint(hrp.Position)
            if onScreen and sp.Z > 0 then
                local ratio = hum.Health / math.max(hum.MaxHealth, 1)
                bg.Position = Vector2.new(sp.X - 30, sp.Y - 40)
                bg.Size = Vector2.new(60, 4) bg.Visible = true
                fill.Position = Vector2.new(sp.X - 30, sp.Y - 40)
                fill.Size = Vector2.new(60 * ratio, 4)
                fill.Color = Color3.fromHSV(ratio * 0.333, 0.8, 0.9)
                fill.Visible = true
            else
                bg.Visible = false fill.Visible = false
            end
        end)
    end)
    if not espCache[plr] then espCache[plr] = {} end
    espCache[plr].hpBg = bg
    espCache[plr].hpFill = fill
    espCache[plr].hpConn = conn
end

local function clearESP(plr)
    if espCache[plr] then
        for _, d in pairs(espCache[plr]) do
            if typeof(d) == "userdata" then
                pcall(function() d:Remove() end)
            else
                pcall(function() d:Disconnect() end)
            end
        end
        espCache[plr] = nil
    end
end

