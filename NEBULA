local activeNotifications = {}

local function CreateNotification(title, msg, dur)
    local pg = LP:FindFirstChild("PlayerGui")
    if not pg then return end
    for i = #activeNotifications, 1, -1 do
        if not activeNotifications[i] or not activeNotifications[i].Parent then
            table.remove(activeNotifications, i)
        end
    end
    local yPos = 90 + (#activeNotifications * 80)
    
    local sg = Instance.new("ScreenGui")
    sg.Name = "JUIXNotify"
    sg.ResetOnSpawn = false
    sg.Parent = pg
    
    local f = Instance.new("Frame", sg)
    f.Size = UDim2.new(0, 280, 0, 70)
    f.Position = UDim2.new(1, 300, 1, -yPos)
    f.AnchorPoint = Vector2.new(0, 1)
    f.BackgroundColor3 = Color3.fromRGB(20, 15, 40)
    f.BackgroundTransparency = 0.3
    f.BorderSizePixel = 0
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 10)
    
    local st = Instance.new("UIStroke", f)
    st.Color = Color3.fromRGB(150, 100, 255)
    st.Thickness = 1.5
    st.Transparency = 0.3
    
    local icon = Instance.new("TextLabel", f)
    icon.Size = UDim2.new(0, 30, 0, 30)
    icon.Position = UDim2.new(0, 15, 0, 10)
    icon.BackgroundTransparency = 1
    icon.Text = "🫐"
    icon.TextSize = 22
    
    local t1 = Instance.new("TextLabel", f)
    t1.Size = UDim2.new(1, -60, 0, 20)
    t1.Position = UDim2.new(0, 55, 0, 8)
    t1.BackgroundTransparency = 1
    t1.Text = title
    t1.TextColor3 = Color3.fromRGB(200, 170, 255)
    t1.TextSize = 14
    t1.Font = Enum.Font.GothamBold
    t1.TextXAlignment = Enum.TextXAlignment.Left
    
    local t2 = Instance.new("TextLabel", f)
    t2.Size = UDim2.new(1, -60, 0, 20)
    t2.Position = UDim2.new(0, 55, 0, 30)
    t2.BackgroundTransparency = 1
    t2.Text = msg
    t2.TextColor3 = Color3.fromRGB(180, 180, 220)
    t2.TextSize = 12
    t2.Font = Enum.Font.Gotham
    t2.TextXAlignment = Enum.TextXAlignment.Left
    
    TweenService:Create(f, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Position = UDim2.new(1, -300, 1, -yPos)
    }):Play()
    
    table.insert(activeNotifications, sg)
    
    task.delay(dur + 0.5, function()
        pcall(function()
            local twOut = TweenService:Create(f, TweenInfo.new(0.5), {
                Position = UDim2.new(1, 300, 1, -yPos)
            })
            twOut:Play()
            twOut.Completed:Wait()
            for i = #activeNotifications, 1, -1 do
                if activeNotifications[i] == sg then
                    table.remove(activeNotifications, i)
                    break
                end
            end
            sg:Destroy()
        end)
    end)
end

